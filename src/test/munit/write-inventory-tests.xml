            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ warehouseStock: 3 }]]></ee:set-payload>
                    <ee:set-attributes><![CDATA[%dw 2.0
output application/java
---
{ uriParams: { itemId: "SKU-MISSING" } }]]></ee:set-attributes>
                </ee:message>
            </ee:transform>
            <try>
                <flow-ref name="patch:\inventory\(itemId):application\json:inventory-api-config"/>
                <error-handler>
                    <on-error-continue type="APP:NOT_FOUND"/>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(404)]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="delete-inventory-soft-delete-test" description="Soft-deletes the item in MySQL only (status=INACTIVE) and never touches Salesforce">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:then-return>
                    <munit-tools:payload value='#[[{
    item_id: "SKU-DEL-001",
    warehouse_stock: 10,
    regional_stock: 10,
    total_inventory: 20,
    safety_stock: 5,
    status: "LOW",
    region: "US"
}]]' mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:update">
                <munit-tools:then-return/>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:insert">
                <munit-tools:then-return/>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="jms:publish">
                <munit-tools:then-return/>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:remove">
                <munit-tools:then-return/>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <ee:transform>
                <ee:message>
                    <ee:set-attributes><![CDATA[%dw 2.0
output application/java
---
{ uriParams: { itemId: "SKU-DEL-001" } }]]></ee:set-attributes>
                </ee:message>
            </ee:transform>
            <flow-ref name="delete:\inventory\(itemId):inventory-api-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('INACTIVE')]"/>
            <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(200)]"/>
            <munit-tools:verify-call processor="salesforce:upsert" doc:name="DELETE never calls Salesforce" times="0"/>
        </munit:validation>
    </munit:test>

    <munit:test name="delete-inventory-not-found-test" description="Returns 404 when the item to delete does not exist">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[]]" mediaType="application/java"/>
