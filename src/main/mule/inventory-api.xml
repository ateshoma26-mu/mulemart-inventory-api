    <flow name="get:\inventory:inventory-api-config">
        <db:select doc:name="Select" doc:id="61596f02-d3ad-44d8-b33e-22eb48eebf2c" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT item_id, warehouse_stock, regional_stock, total_inventory, safety_stock, status, region, last_updated FROM inventory]]></db:sql>
		</db:select>
		<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
import * from InventoryLib
---
payload map (row) -> do {
    var total = calculateTotal(row.warehouse_stock, row.regional_stock)
    ---
    {
        itemId: row.item_id,
        warehouseStock: row.warehouse_stock,
        regionalStock: row.regional_stock,
        totalInventory: total,
        safetyStock: row.safety_stock,
        status: calculateStatus(total),
        region: row.region,
        lastUpdated: row.last_updated
    }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="get:\inventory\(itemId)\summary:inventory-api-config">
        <db:select doc:name="Select" doc:id="c5162c39-4415-482c-b0ec-b2897a0f7b4c" config-ref="Database_Config">
			<db:sql ><![CDATA[     SELECT item_id, warehouse_stock, regional_stock, total_inventory, safety_stock, status, region, last_updated FROM inventory WHERE item_id = :itemId]]></db:sql>
			<db:input-parameters ><![CDATA[     #[{ itemId: attributes.uriParams.itemId }]]]></db:input-parameters>
		</db:select>
		<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
import * from InventoryLib
---
if (isEmpty(payload))
    null
else do {
    var row = payload[0]
    var total = calculateTotal(row.warehouse_stock, row.regional_stock)
    ---
    {
        itemId: row.item_id,
        totalInventory: total,
        status: calculateStatus(total),
        reorderQuantity: calculateReorder(total),
        region: row.region
    }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="get:\inventory\(itemId):inventory-api-config">
