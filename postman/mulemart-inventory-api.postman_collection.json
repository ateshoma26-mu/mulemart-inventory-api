          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "url": "{{baseUrl}}/inventory",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"SKU-DEMO2-003\",\n  \"warehouseStock\": 150,\n  \"regionalStock\": 100,\n  \"safetyStock\": 30,\n  \"region\": \"APAC\"\n}"
