    {
      "name": "Bulk & Sync",
      "item": [
        {
          "name": "POST Bulk Create (mixed success/failure)",
          "description": "5 records submitted: 3 should succeed (SKU-BULK2-001 healthy, SKU-BULK2-002 CRITICAL - triggers a procurement alert, SKU-BULK2-003 healthy), and 2 should fail inside the batch job (SKU-DEMO2-001 as a duplicate - run 'Inventory - Create' first so it already exists, and SKU-BULK2-004 with negative warehouseStock - fails validation). The 202 response only echoes totalRecords submitted; the actual per-item successCount/failureCount split is written to the application log when the async batch job completes (see 'Log SyncResponse' in the Mule log), so wait a few seconds then use the two verification requests below to confirm which records landed.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202', () => pm.response.to.have.status(202));",
                  "pm.test('Status is ACCEPTED', () => pm.expect(pm.response.json().status).to.eql('ACCEPTED'));",
                  "pm.test('totalRecords reflects all 5 submitted', () => pm.expect(pm.response.json().totalRecords).to.eql(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "url": "{{baseUrl}}/inventory/bulk",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"itemId\": \"SKU-BULK2-001\",\n    \"warehouseStock\": 100,\n    \"regionalStock\": 60,\n    \"safetyStock\": 20,\n    \"region\": \"NA-WEST\"\n  },\n  {\n    \"itemId\": \"SKU-BULK2-002\",\n    \"warehouseStock\": 2,\n    \"regionalStock\": 1,\n    \"safetyStock\": 20,\n    \"region\": \"NA-WEST\"\n  },\n  {\n    \"itemId\": \"SKU-BULK2-003\",\n    \"warehouseStock\": 40,\n    \"regionalStock\": 30,\n    \"safetyStock\": 15,\n    \"region\": \"APAC\"\n  },\n  {\n    \"itemId\": \"SKU-DEMO2-001\",\n    \"warehouseStock\": 10,\n    \"regionalStock\": 10,\n    \"safetyStock\": 5,\n    \"region\": \"EU-WEST\"\n  },\n  {\n    \"itemId\": \"SKU-BULK2-004\",\n    \"warehouseStock\": -5,\n    \"regionalStock\": 10,\n    \"safetyStock\": 20,\n    \"region\": \"APAC\"\n  }\n]"
            }
          }
        },
        {
          "name": "GET Verify Bulk Success Item (SKU-BULK2-002 should exist, CRITICAL)",
          "description": "Run a few seconds after 'POST Bulk Create' so the async batch job has time to finish inserting.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is CRITICAL', () => pm.expect(pm.response.json().status).to.eql('CRITICAL'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory/SKU-BULK2-002"
          }
        },
        {
          "name": "GET Verify Bulk Failure Item (SKU-BULK2-004 should NOT exist - expect 404)",
          "description": "Confirms the negative-stock record from the bulk batch was rejected and never inserted.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Code is NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory/SKU-BULK2-004"
          }
        },
        {
          "name": "POST Trigger Full Sync",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202', () => pm.response.to.have.status(202));",
                  "pm.test('Status is ACCEPTED', () => pm.expect(pm.response.json().status).to.eql('ACCEPTED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/inventory/sync"
          }
        }
      ]
    },
    {
      "name": "JMS Event Verification (CRITICAL alert + inventory.update.queue)",
      "description": "Manual test sequence for verifying the CRITICAL procurement alert on create/update and the inventory.update.queue CREATE/UPDATE/DELETE audit events. Run in order; watch procurement.alert.queue and inventory.update.queue in the ActiveMQ console (default http://localhost:8161/admin) as you go.",
      "item": [
        {
          "name": "1. POST create - immediately CRITICAL (CREATE event + procurement alert)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is CRITICAL', () => pm.expect(pm.response.json().status).to.eql('CRITICAL'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "url": "{{baseUrl}}/inventory",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"SKU-TEST2-100\",\n  \"warehouseStock\": 3,\n  \"regionalStock\": 4,\n  \"safetyStock\": 20,\n  \"region\": \"US-EAST\"\n}"
            }
          }
        },
        {
          "name": "2. POST create - healthy (CREATE event only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is HEALTHY', () => pm.expect(pm.response.json().status).to.eql('HEALTHY'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "url": "{{baseUrl}}/inventory",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"SKU-TEST2-200\",\n  \"warehouseStock\": 80,\n  \"regionalStock\": 70,\n  \"safetyStock\": 20,\n  \"region\": \"US-WEST\"\n}"
            }
          }
        },
        {
          "name": "3. PUT - push SKU-TEST2-200 into CRITICAL (procurement alert)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is CRITICAL', () => pm.expect(pm.response.json().status).to.eql('CRITICAL'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "url": "{{baseUrl}}/inventory/SKU-TEST2-200",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"SKU-TEST2-200\",\n  \"warehouseStock\": 2,\n  \"regionalStock\": 3,\n  \"safetyStock\": 20,\n  \"region\": \"US-WEST\"\n}"
            }
          }
        },
        {
          "name": "4. PATCH - partial update, still CRITICAL (procurement alert again)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is CRITICAL', () => pm.expect(pm.response.json().status).to.eql('CRITICAL'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "url": "{{baseUrl}}/inventory/SKU-TEST2-200",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseStock\": 4\n}"
            }
          }
        },
        {
          "name": "5. PATCH - raise back to healthy (UPDATE event, no alert)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is HEALTHY', () => pm.expect(pm.response.json().status).to.eql('HEALTHY'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "url": "{{baseUrl}}/inventory/SKU-TEST2-200",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseStock\": 100,\n  \"regionalStock\": 100\n}"
            }
          }
        },
        {
          "name": "6. DELETE - soft delete (DELETE event)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is INACTIVE', () => pm.expect(pm.response.json().status).to.eql('INACTIVE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/inventory/SKU-TEST2-200"
          }
        },
        {
          "name": "7. GET item (sanity check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is INACTIVE', () => pm.expect(pm.response.json().status).to.eql('INACTIVE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory/SKU-TEST2-200"
          }
        }
      ]
    }
  ]
