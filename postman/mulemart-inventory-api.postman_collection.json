          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "url": "{{baseUrl}}/inventory",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"SKU-DEMO2-001\",\n  \"warehouseStock\": 80,\n  \"regionalStock\": 70,\n  \"safetyStock\": 20,\n  \"region\": \"EU-WEST\"\n}"
            }
