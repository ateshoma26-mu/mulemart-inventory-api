              "raw": "{\n  \"itemId\": \"SKU-DEMO2-BAD\",\n  \"warehouseStock\": -5,\n  \"regionalStock\": 10,\n  \"region\": \"EU-WEST\"\n}"
            }
          }
        }
      ]
    },
