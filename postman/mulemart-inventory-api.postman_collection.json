                  "pm.test('Status is CRITICAL', () => pm.expect(pm.response.json().status).to.eql('CRITICAL'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "url": "{{baseUrl}}/inventory",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"SKU-DEMO2-002\",\n  \"warehouseStock\": 3,\n  \"regionalStock\": 4,\n  \"safetyStock\": 20,\n  \"region\": \"NA-EAST\"\n}"
            }
