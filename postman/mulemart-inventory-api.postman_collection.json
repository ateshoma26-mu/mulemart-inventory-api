                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "url": "{{baseUrl}}/inventory/SKU-DEMO2-001",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"SKU-DEMO2-001\",\n  \"warehouseStock\": 60,\n  \"regionalStock\": 50,\n  \"safetyStock\": 20,\n  \"region\": \"EU-WEST\"\n}"
            }
          }
        },
